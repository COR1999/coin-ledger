# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.
# All values are read and validated server-side by lib/env.ts at startup.

# Which payment provider the execution path uses. mock | arc
PAYMENT_PROVIDER=mock

# Arc RPC endpoint from `arc-canteen rpc-url`. Contains your Canteen token,
# so treat the whole URL as a secret. Not currently used by the arc provider
# (Circle's API is called directly instead) — kept for later traction tracking.
ARC_RPC_URL=

# Not used — the confirmed architecture is Circle developer-controlled
# wallets, not a raw-key wallet. Left here in case that ever changes.
ARC_PRIVATE_KEY=

# Google Gemini key for the finance agent. Required from Phase 3.
GOOGLE_API_KEY=

# Max chat messages per visitor (by IP) per hour, on a public deployment —
# protects the shared Gemini free-tier quota from one visitor exhausting it.
# Defaults to 10 if unset.
CHAT_RATE_LIMIT_PER_HOUR=

# Circle developer-controlled wallets (see BUILD_LOG.md Decisions).
# From Circle Console (console.circle.com), Sandbox/Testnet mode.
# Required once PAYMENT_PROVIDER=arc.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# The business wallet's address, created once via scripts/create-arc-wallet.ts.
CIRCLE_WALLET_ADDRESS=

# Gates /admin/waitlist (view collected waitlist signups). Generate with
# `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`
# and set on your deployment platform directly — never commit the real value.
# Unset in local dev is fine; see app/admin/waitlist/page.tsx for the fallback.
WAITLIST_ADMIN_SECRET=

# Max waitlist signups per visitor (by IP) per hour. Defaults to 5 if unset.
WAITLIST_RATE_LIMIT_PER_HOUR=

# Optional: enables persistent, cross-serverless-instance storage for
# onboarded workspaces and waitlist signups (see README.md "Data
# persistence"). Both unset (the default) keeps the existing in-memory
# behavior unchanged — fine for local dev, not reliable on Vercel's
# serverless deployment model for anything other than the canned demo.
# From a Redis database at upstash.com (or Vercel's Upstash integration).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
