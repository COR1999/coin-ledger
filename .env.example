# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.
# All values are read and validated server-side by lib/env.ts at startup.

# Which payment provider the execution path uses. mock | arc
PAYMENT_PROVIDER=mock

# Arc RPC endpoint from `arc-canteen rpc-url`. Contains your Canteen token,
# so treat the whole URL as a secret. Required once PAYMENT_PROVIDER=arc.
ARC_RPC_URL=

# Only if the confirmed wallet architecture uses a raw-key wallet.
# Testnet-only disposable wallet. Never a real key.
ARC_PRIVATE_KEY=

# Anthropic API key for the finance agent. Required from Phase 3.
ANTHROPIC_API_KEY=sk-ant-...
